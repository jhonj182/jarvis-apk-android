{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/jarvis/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "jarvis",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/jarvis/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071019"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.jhontamayo.jarvis",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Jarvis se conecta con Orca Lab en tu escritorio por la red local.",
        "NSMicrophoneUsageDescription": "Permite que Jarvis grabe tu voz para dictar. El audio se envía a tu escritorio emparejado para transcribirlo.",
        "NSPhotoLibraryUsageDescription": "Permite que Jarvis adjunte fotos de tu biblioteca a una sesión de terminal en tu escritorio emparejado.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "fd7a:115c:a1e0::/48": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/jarvis/adaptive-icon.png",
        "backgroundColor": "#071019"
      },
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "package": "dev.jhontamayo.jarvis",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "./plugins/android-respect-rotation-lock.js",
      "./plugins/android-upload-signing.js",
      "./plugins/jarvis-android-manifest.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/jarvis/splash-icon.png",
          "backgroundColor": "#071019"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que Jarvis use la cámara para escanear el código QR de emparejamiento con tu escritorio.",
          "microphonePermission": "Permite que Jarvis use el micrófono para dictar por voz. El audio se envía a tu escritorio emparejado para transcribirlo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Jarvis adjunte fotos de tu biblioteca a una sesión de terminal en tu escritorio emparejado."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que Jarvis use Face ID para desbloquear la app."
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ChakraPetch-SemiBold.ttf"]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
